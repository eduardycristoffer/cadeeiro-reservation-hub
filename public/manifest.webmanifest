{
  "id": "/admin",
  "name": "Candeeiro Gestão",
  "short_name": "Candeeiro",
  "description": "Reservas, aprovações, atendimento e alertas da Rede Candeeiro, no seu celular.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "/admin?origem=app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "categories": ["business", "productivity", "food"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Aprovações",
      "short_name": "Aprovar",
      "description": "Reservas esperando aprovação",
      "url": "/admin/aprovacoes?origem=atalho",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Reservas de hoje",
      "short_name": "Reservas",
      "url": "/admin/reservas?origem=atalho",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Alertas",
      "short_name": "Alertas",
      "url": "/admin/alertas?origem=atalho",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "SAC",
      "short_name": "SAC",
      "url": "/admin/sac?origem=atalho",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
